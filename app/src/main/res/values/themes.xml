<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme — dark antique luxury -->
    <style name="Theme.DClassicsBooks.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>
        <item name="colorSecondary">@color/gold_dark</item>
        <item name="colorOnSecondary">@color/text_on_gold</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Default theme (API < 35) -->
    <style name="Theme.DClassicsBooks" parent="Theme.DClassicsBooks.Base"/>

    <!-- Login: status bar blends with the dark gradient -->
    <style name="Theme.DClassicsBooks.Login" parent="Theme.DClassicsBooks">
        <item name="android:statusBarColor">@color/bg_primary</item>
    </style>

    <!-- ── Widget styles ─────────────────────────────────────────────────── -->

    <style name="Widget.DClassicsBooks.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="hintTextColor">@color/selector_hint_text</item>
        <item name="boxBackgroundColor">@color/surface_light</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconDrawable">@null</item>
    </style>

    <style name="Widget.DClassicsBooks.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconSize">24dp</item>
    </style>

    <style name="Widget.DClassicsBooks.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextColor">@color/text_hint</item>
        <item name="tabSelectedTextColor">@color/gold_dark</item>
        <item name="tabIndicatorColor">@color/gold_primary</item>
        <item name="tabBackground">@color/surface</item>
        <item name="tabTextAppearance">@style/TextAppearance.DClassicsBooks.Tab</item>
        <item name="tabIndicatorHeight">3dp</item>
    </style>

    <style name="TextAppearance.DClassicsBooks.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

</resources>
