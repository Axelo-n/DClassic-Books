<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/cover_meditations_start"
                android:endColor="@color/cover_meditations_end"
                android:angle="135"/>
        </shape>
    </item>
    <item android:gravity="center" android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#20C9A84C"/>
            <corners android:radius="4dp"/>
            <size android:width="40dp" android:height="2dp"/>
        </shape>
    </item>
</layer-list>
