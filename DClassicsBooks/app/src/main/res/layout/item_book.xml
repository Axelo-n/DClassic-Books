<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="@dimen/corner_lg"
    app:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Book Cover -->
        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="@dimen/book_item_cover_width"
            android:layout_height="@dimen/book_item_cover_height"
            android:scaleType="centerCrop"
            android:contentDescription="Book cover"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Gold spine accent -->
        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:alpha="0.6"
            app:layout_constraintTop_toTopOf="@id/iv_book_cover"
            app:layout_constraintBottom_toBottomOf="@id/iv_book_cover"
            app:layout_constraintStart_toStartOf="@id/iv_book_cover"/>

        <!-- Info area -->
        <LinearLayout
            android:id="@+id/ll_book_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_book_cover"
            app:layout_constraintEnd_toStartOf="@id/iv_chevron"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Genre badge -->
            <TextView
                android:id="@+id/tv_book_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NON-FICTION"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_badge_genre"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="8dp"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meditations"
                android:textSize="16sp"
                android:fontFamily="@font/aleo_semibold"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"/>

            <!-- Author -->
            <TextView
                android:id="@+id/tv_book_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marcus Aurelius"
                android:textSize="12sp"
                android:fontFamily="@font/aleo_semibold"
                android:textStyle="italic"
                android:layout_marginTop="4dp"/>

            <!-- Rating row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="Rating star"/>

                <TextView
                    android:id="@+id/tv_book_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="4dp"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tv_book_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Philosophy"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:id="@+id/iv_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Open"
            android:alpha="0.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
