<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/featured_book_width"
    android:layout_height="@dimen/featured_book_height"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="@dimen/corner_lg"
    app:cardBackgroundColor="@color/card"
    app:cardElevation="6dp"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Book Cover (top portion) -->
        <ImageView
            android:id="@+id/iv_featured_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="Book cover"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.68"/>

        <!-- Gradient overlay on cover -->
        <View
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_carousel_gradient"
            app:layout_constraintBottom_toBottomOf="@id/iv_featured_cover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Book spine accent (left edge) -->
        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@color/gold_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Genre Badge -->
        <TextView
            android:id="@+id/tv_featured_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FICTION"
            android:textColor="@color/gold_light"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_badge_genre"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Info area (bottom portion) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/iv_featured_cover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_featured_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meditations"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"/>

            <TextView
                android:id="@+id/tv_featured_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marcus Aurelius"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
