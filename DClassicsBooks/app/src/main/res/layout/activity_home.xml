<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- === TOP APP BAR === -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="@dimen/screen_padding">

            <!-- Logo + App Name -->
            <ImageView
                android:id="@+id/iv_toolbar_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="Logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D'Classics"
                android:textSize="20sp"
                android:fontFamily="@font/aleo_semibold"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@id/iv_toolbar_logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- More / Logout icon -->
            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Subtle divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- === MAIN SCROLL CONTENT === -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- === GREETING CARD === -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_greeting_card"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hello, Reader!"
                            android:textSize="22sp"
                            android:fontFamily="@font/aleo_semibold"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_home_subtitle"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_auto_stories"
                        android:contentDescription="Books icon"
                        android:layout_marginStart="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- === FEATURED BOOKS SECTION === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <!-- Left accent bar -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_featured_books"
                    android:textSize="18sp"
                    android:fontFamily="@font/aleo_semibold"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_see_all_books"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_see_all"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>

            <!-- Featured Books Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_featured_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- === OUR STORES SECTION === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="28dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_our_stores"
                        android:textSize="18sp"
                        android:fontFamily="@font/aleo_semibold"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_stores_subtitle"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- === CAROUSEL CONTAINER === -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding">

                <!-- ViewPager2 Carousel -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_carousel"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/carousel_height"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Prev Button -->
                <ImageButton
                    android:id="@+id/btn_carousel_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_chevron_left"
                    android:background="@drawable/bg_carousel_btn"
                    android:contentDescription="Previous"
                    android:padding="8dp"
                    android:elevation="4dp"
                    app:layout_constraintTop_toTopOf="@id/vp_carousel"
                    app:layout_constraintBottom_toBottomOf="@id/vp_carousel"
                    app:layout_constraintStart_toStartOf="@id/vp_carousel"
                    android:layout_marginStart="8dp"/>

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/btn_carousel_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_chevron_right"
                    android:background="@drawable/bg_carousel_btn"
                    android:contentDescription="Next"
                    android:padding="8dp"
                    android:elevation="4dp"
                    app:layout_constraintTop_toTopOf="@id/vp_carousel"
                    app:layout_constraintBottom_toBottomOf="@id/vp_carousel"
                    app:layout_constraintEnd_toEndOf="@id/vp_carousel"
                    android:layout_marginEnd="8dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Carousel Dot Indicators -->
            <LinearLayout
                android:id="@+id/ll_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"/>

            <!-- === BOTTOM SPACER === -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- === BOTTOM NAVIGATION === -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_navigation"
        app:elevation="16dp"
        app:selectedItemId="@id/nav_home"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
