<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#0D3A4A" android:endColor="#0A5A74"
                android:angle="135" android:type="linear"/>
        </shape>
    </item>
    <item android:top="0dp" android:right="0dp" android:bottom="0dp" android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#C9A84C"/>
        </shape>
    </item>
    <item android:gravity="center_horizontal|top" android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF"/>
            <corners android:radius="2dp"/>
            <size android:width="40dp" android:height="3dp"/>
        </shape>
    </item>
    <item android:gravity="center_horizontal|top" android:top="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF"/>
            <corners android:radius="2dp"/>
            <size android:width="30dp" android:height="3dp"/>
        </shape>
    </item>
</layer-list>
