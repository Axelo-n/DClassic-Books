<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DClassicsBooks" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_dark</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>
        <item name="colorPrimaryContainer">@color/gold_subtle</item>
        <item name="colorOnPrimaryContainer">@color/gold_light</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/gold_light</item>
        <item name="colorOnSecondary">@color/text_on_gold</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorBackground">@color/bg_primary</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_secondary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- TextInputLayout style -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.OutlinedBox</item>
    </style>

    <!-- ===============================
         TEXT INPUT LAYOUT STYLES
         =============================== -->

    <style name="Widget.App.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="hintTextColor">@color/selector_hint_text</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="startIconTint">@color/text_hint</item>
    </style>

    <!-- ===============================
         TOOLBAR STYLE
         =============================== -->

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg_primary</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.Toolbar.Title</item>
    </style>

    <style name="TextAppearance.App.Toolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===============================
         TAB LAYOUT STYLE
         =============================== -->

    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabBackground">@color/transparent</item>
        <item name="tabSelectedTextColor">@color/gold_primary</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabIndicatorColor">@color/gold_primary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Tab</item>
        <item name="tabRippleColor">@color/gold_subtle</item>
    </style>

    <style name="TextAppearance.App.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- ===============================
         BOTTOM NAVIGATION STYLE
         =============================== -->

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorColor">@color/gold_subtle</item>
        <item name="android:background">@color/bg_secondary</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.BottomNav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.BottomNav</item>
    </style>

    <style name="TextAppearance.App.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- ===============================
         CARD STYLE
         =============================== -->

    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/corner_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <!-- ===============================
         BUTTON STYLES
         =============================== -->

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_gold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/gold_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/gold_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/corner_md</item>
    </style>

    <!-- ===============================
         CHIP STYLE
         =============================== -->

    <style name="Widget.App.Chip.Genre" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">4dp</item>
        <item name="chipMinHeight">24dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

</resources>
