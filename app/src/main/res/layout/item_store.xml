<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space200"
    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large"
    app:cardElevation="@dimen/elevation_level0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space250"
            android:paddingTop="@dimen/space200"
            android:paddingBottom="@dimen/space250">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space200">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent"
                    android:layout_marginEnd="@dimen/space125"/>

                <TextView
                    android:id="@+id/tv_store_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/store_name"
                    android:textAppearance="?attr/textAppearanceTitleMedium"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_store_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/address"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:drawableStart="@drawable/location_on_24px"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                android:drawablePadding="@dimen/space125"
                android:layout_marginBottom="@dimen/space125"
                android:gravity="center_vertical"/>

            <TextView
                android:id="@+id/tv_store_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:drawableStart="@drawable/call_24px"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                android:drawablePadding="@dimen/space125"
                android:layout_marginBottom="@dimen/space125"
                android:gravity="center_vertical"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/store_hours"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:drawableStart="@drawable/schedule_24px"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                android:drawablePadding="@dimen/space125"
                android:gravity="center_vertical"/>

        </LinearLayout>

</com.google.android.material.card.MaterialCardView>
