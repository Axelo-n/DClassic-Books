<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#514018"
                android:centerColor="#3A2E12"
                android:endColor="#292009"
                android:angle="315"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#40D2B36A"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
